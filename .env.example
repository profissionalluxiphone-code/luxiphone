# Porta do servidor (o Render define isso automaticamente)
PORT=3000

# Token usado para entrar no painel admin.html
ADMIN_TOKEN=troque-este-token

# --- Login com Google (obrigatório para o cliente finalizar a compra) ---
# Crie um "OAuth Client ID" do tipo "Web application" em
# https://console.cloud.google.com/apis/credentials (gratuito, não pede cartão).
# Em "Authorized JavaScript origins" adicione a URL do site (ex.: http://localhost:3000
# em dev e https://seu-site.onrender.com em produção). O valor abaixo é público (aparece
# no navegador) — não é segredo. Sem isso definido, o botão de login não funciona e
# ninguém consegue finalizar pedidos.
GOOGLE_CLIENT_ID=

# Segredo usado para assinar o cookie de sessão de login. Gere um valor aleatório
# (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# e troque em produção — no Render isso é gerado automaticamente pelo render.yaml.
SESSION_SECRET=troque-em-producao

# String de conexão do PostgreSQL.
# No Render, o render.yaml preenche isso automaticamente a partir do banco criado no blueprint.
# Em desenvolvimento local, deixe em branco: o servidor usa um banco SQLite local
# (arquivo server/data/luxiphones.sqlite, criado automaticamente).
DATABASE_URL=

# --- Mercado Pago (gateway de pagamento) ---
# Sem isso definido, o checkout usa o fluxo manual (pedido + confirmação por WhatsApp).
# Pegue suas credenciais de teste em https://www.mercadopago.com.br/developers/panel/app
# (Suas integrações > credenciais de teste). Token de teste começa com "TEST-".
MP_ACCESS_TOKEN=

# Chave PÚBLICA (não é segredo, pode aparecer no navegador). Com ela definida, o
# pagamento por cartão acontece direto no site (formulário seguro do Mercado Pago,
# embutido no checkout) em vez de redirecionar o cliente para outra página. Pix e
# boleto continuam usando o checkout redirecionado do Mercado Pago.
MP_PUBLIC_KEY=

# Opcional, mas recomendado em produção: secret do webhook (painel do Mercado Pago >
# sua aplicação > Webhooks > "Assinatura secreta"). Sem isso, o servidor não consegue
# validar que a notificação de pagamento realmente veio do Mercado Pago.
MP_WEBHOOK_SECRET=

# URL pública do site, usada para montar os links de retorno e o webhook.
# No Render isso é preenchido automaticamente (RENDER_EXTERNAL_URL). Em localhost, não
# precisa definir — mas repare que o Mercado Pago não consegue notificar um servidor em
# localhost (veja o README para testar webhooks localmente).
PUBLIC_BASE_URL=
